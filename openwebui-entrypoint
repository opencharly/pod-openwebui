#!/usr/bin/env bash
set -euo pipefail

# Open WebUI auto-configuration entrypoint.
# ENABLE_PERSISTENT_CONFIG=false keeps the database from ever overriding env:
# upstream's Config.get() answers from the env-built defaults on every read, so
# no sentinel is needed. (Admin-panel edits then live in process memory only —
# they are never persisted, and the next start re-derives everything from here.)
#
# EVERY provider-derived value below is a DEFAULT (`${VAR:-derived}`), never an
# assignment that overwrites: a deployment must be able to use any variable its
# service documents, so an operator's explicit value always wins and the
# derivation only fills what was left unset (opencharly/pod-openwebui#29).

# --- Data directory ---
mkdir -p "$DATA_DIR"

# --- Read WEBUI_SECRET_KEY (auto-generated podman secret) ---
if [ -z "${WEBUI_SECRET_KEY:-}" ] && [ -f /run/secrets/webui-secret-key ]; then
    export WEBUI_SECRET_KEY="$(cat /run/secrets/webui-secret-key)"
fi

# --- LLM Providers ---
# Build semicolon-separated lists for multiple OpenAI-compatible backends.
# Open WebUI supports OPENAI_API_BASE_URLS + OPENAI_API_KEYS (plural, semicolon-separated).
URLS=""
KEYS=""

# OpenRouter
if [ -n "${OPENROUTER_API_KEY:-}" ]; then
    URLS="https://openrouter.ai/api/v1"
    KEYS="$OPENROUTER_API_KEY"
    echo "openwebui-entrypoint: OpenRouter configured"
fi

# Ollama Cloud (additive — both can be active simultaneously)
if [ -n "${OLLAMA_API_KEY:-}" ]; then
    if [ -n "$URLS" ]; then
        URLS="$URLS;https://ollama.com/v1"
        KEYS="$KEYS;$OLLAMA_API_KEY"
    else
        URLS="https://ollama.com/v1"
        KEYS="$OLLAMA_API_KEY"
    fi
    echo "openwebui-entrypoint: Ollama Cloud configured"
fi

# Direct OpenAI (additive). The KEY is what declares the provider; the base URL only
# says which endpoint. Requiring both meant the declared `OPENAI_API_KEY` secret did
# nothing on its own — the user set it, no provider appeared, and nothing said why. The
# upstream default is used when the URL is absent, exactly as Open Web UI would default it.
if [ -n "${OPENAI_API_KEY:-}" ]; then
    OPENAI_BASE="${OPENAI_API_BASE_URL:-https://api.openai.com/v1}"
    if [ -n "$URLS" ]; then
        URLS="$URLS;$OPENAI_BASE"
        KEYS="$KEYS;$OPENAI_API_KEY"
    else
        URLS="$OPENAI_BASE"
        KEYS="$OPENAI_API_KEY"
    fi
    echo "openwebui-entrypoint: OpenAI-compatible at $OPENAI_BASE"
fi

if [ -n "$URLS" ]; then
    export OPENAI_API_BASE_URLS="${OPENAI_API_BASE_URLS:-$URLS}"
    export OPENAI_API_KEYS="${OPENAI_API_KEYS:-$KEYS}"
fi

# Local Ollama (native API, only when OLLAMA_HOST is provided by env_provides)
if [ -n "${OLLAMA_HOST:-}" ]; then
    export ENABLE_OLLAMA_API="${ENABLE_OLLAMA_API:-true}"
    export OLLAMA_BASE_URL="${OLLAMA_BASE_URL:-$OLLAMA_HOST}"
    echo "openwebui-entrypoint: Local Ollama at $OLLAMA_BASE_URL"
else
    # No provider: default the switch OFF, but never override an operator who
    # pointed OLLAMA_BASE_URL at their own server.
    export ENABLE_OLLAMA_API="${ENABLE_OLLAMA_API:-false}"
fi

# --- Speech synthesis (TTS) from a provided OpenAI-compatible speech server ---
# QWEN3_TTS_HOST is injected by a provider candy's env_provide (see env_accept).
# The ENGINE and its BASE URL are projected as a PAIR on purpose: Open Web UI
# defaults AUDIO_TTS_OPENAI_API_BASE_URL to OPENAI_API_BASE_URL, which on a pod
# with an LLM provider is the CHAT server — so setting the engine alone would
# send every speech request to the wrong service and surface as a connection
# error. The API key is pinned too, for the same reason: it inherits
# OPENAI_API_KEY, i.e. the chat credential, which the speech server has no
# business receiving. response_format=mp3 is a preference, not a requirement:
# this candy now REQUIRES layer-ffmpeg (pydub is a hard dependency of
# open-webui and its binary was missing — issue #20), so a WAV reply is
# transcoded correctly too. mp3 is kept as the default because it makes the
# consumer's ".mp3"-named speech cache coherent and skips that transcode.
if [ -n "${QWEN3_TTS_HOST:-}" ]; then
    export AUDIO_TTS_ENGINE="${AUDIO_TTS_ENGINE:-openai}"
    export AUDIO_TTS_OPENAI_API_BASE_URL="${AUDIO_TTS_OPENAI_API_BASE_URL:-$QWEN3_TTS_HOST}"
    export AUDIO_TTS_OPENAI_API_KEY="${AUDIO_TTS_OPENAI_API_KEY:-${QWEN3_TTS_API_KEY:-not-needed}}"
    export AUDIO_TTS_MODEL="${AUDIO_TTS_MODEL:-${QWEN3_TTS_SERVED_MODEL:-qwen3-tts}}"
    export AUDIO_TTS_VOICE="${AUDIO_TTS_VOICE:-${QWEN3_TTS_VOICE:-vivian}}"
    if [ -z "${AUDIO_TTS_OPENAI_PARAMS:-}" ]; then
        export AUDIO_TTS_OPENAI_PARAMS='{"response_format":"mp3"}'
    fi
    echo "openwebui-entrypoint: TTS (speech) at $AUDIO_TTS_OPENAI_API_BASE_URL"
fi

# --- Speech-to-text (whisper ASR server) ---
# Open Web UI's STT engine values are '' (built-in local faster-whisper) | openai |
# deepgram | azure | mistral. There is NO 'local' value and there is no enable gate — the
# engine value IS the switch. Its client APPENDS '/audio/transcriptions' to the configured
# base URL, so WHISPER_BASE_URL must end in /v1 (measured at v0.13.3:
# routers/audio/__init__.py:924,942; the names are unchanged in v0.13.4). The server's
# reply must carry a top-level `text`.
if [ -n "${WHISPER_BASE_URL:-}" ]; then
    export AUDIO_STT_ENGINE="${AUDIO_STT_ENGINE:-openai}"
    export AUDIO_STT_OPENAI_API_BASE_URL="${AUDIO_STT_OPENAI_API_BASE_URL:-${WHISPER_BASE_URL%/}}"   # no trailing slash

    # The model name belongs WITH the model: forwarded when the provider supplies one, and
    # left empty otherwise (Open Web UI then sends `model=` and the server answers with the
    # checkpoint IT is serving). A fabricated default here would be a silent wrong value.
    if [ -n "${WHISPER_MODEL:-}" ]; then
        export AUDIO_STT_MODEL="${WHISPER_MODEL}"
    fi

    # MEASURED TRAP: AUDIO_STT_OPENAI_API_KEY defaults to OPENAI_API_KEY (config.py:1588),
    # so leaving it unset in a KEYED whisper deployment would ship the CHAT provider's
    # credential to the ASR server and take a 401. Forward the whisper key when present.
    if [ -n "${WHISPER_API_KEY:-}" ]; then
        export AUDIO_STT_OPENAI_API_KEY="${WHISPER_API_KEY}"
    fi

    echo "openwebui-entrypoint: STT via whisper at ${AUDIO_STT_OPENAI_API_BASE_URL} (model ${AUDIO_STT_MODEL:-server default})"
else
    # An absent provider must NOT be advertised as a remote engine: without this branch a
    # deployment with no whisper server would still claim engine=openai and turn every voice
    # memo into a 500. Leave the upstream default (local faster-whisper) and say so.
    echo "openwebui-entrypoint: no whisper server provided; STT stays on the upstream default (local)" >&2
fi

# --- RAG vector store (Qdrant) ---
# QDRANT_URL arrives from the qdrant layer's env_provide (name-matched: the provider's
# name is QDRANT_URL, Open WebUI's own variable is QDRANT_URI — this one hop is the whole
# translation). The admin key arrives from the credential store via secret_accept. Both,
# or neither: an optional secret_accept that misses is silently omitted, and a keyless
# Qdrant only fails later as a 401 behind a 503 — so the partial case is loud HERE.
# VECTOR_DB and QDRANT_URI are plain module-level os.getenv reads in config.py (not
# PersistentConfig), so these exports are the only way to move the vector store off the
# in-container Chroma default; the admin panel cannot persist a vector-store choice.
if [ -n "${QDRANT_URL:-}" ]; then
    if [ -z "${QDRANT_API_KEY:-}" ]; then
        echo "" >&2
        echo "ERROR: QDRANT_URL is set but QDRANT_API_KEY did not resolve." >&2
        echo "" >&2
        echo "The qdrant layer stores its admin key at charly/api-key/qdrant. Deploy" >&2
        echo "qdrant first (its secret_require generates the key), or set it with:" >&2
        echo "" >&2
        echo "  charly secrets set charly/api-key qdrant <value>" >&2
        echo "" >&2
        exit 1
    fi
    export VECTOR_DB="${VECTOR_DB:-qdrant}"
    export QDRANT_URI="${QDRANT_URI:-$QDRANT_URL}"
    echo "openwebui-entrypoint: Qdrant vector store at $QDRANT_URI"
fi

# --- MCP Servers + Jupyter from CHARLY_MCP_SERVERS ---
if [ -n "${CHARLY_MCP_SERVERS:-}" ]; then
    eval "$(python3 - "$CHARLY_MCP_SERVERS" "${CODE_EXECUTION_JUPYTER_AUTH_TOKEN:-}" <<'PYEOF'
import sys, json

mcp_json, jupyter_token = sys.argv[1], sys.argv[2]

try:
    servers = json.loads(mcp_json)
except json.JSONDecodeError:
    print('echo "openwebui-entrypoint: warning: could not parse CHARLY_MCP_SERVERS" >&2', flush=True)
    sys.exit(0)

# Build TOOL_SERVER_CONNECTIONS for Open WebUI
tool_connections = []
jupyter_url = ""
for srv in servers:
    # info.id is the server's IDENTITY, not decoration: Open WebUI keys the tool
    # id (`server:mcp:<id>`, routers/tools.py), the connected-client map, the
    # OAuth client key and the access-control lookup on it. An empty id collapses
    # every MCP server onto one identity — use the (contract-unique) server name.
    conn = {
        "type": "mcp",
        "url": srv["url"],
        "spec_type": "url", "spec": "", "path": "",
        "auth_type": "", "key": "",
        "config": {"enable": True},
        "info": {"id": srv["name"], "name": srv["name"], "description": f"MCP: {srv['name']}"}
    }
    tool_connections.append(conn)
    # Detect jupyter by name or port pattern
    if srv["name"] == "jupyter" or "8888/mcp" in srv.get("url", ""):
        jupyter_url = srv["url"].rsplit("/mcp", 1)[0]

if tool_connections:
    encoded = json.dumps(tool_connections)
    # Shell-safe: single-quote the JSON
    # Derived into a separate variable so the export can default the real one with
    # shell expansion: the JSON carries quotes, which cannot sit inside a
    # `${VAR:-…}` written into a double-quoted string.
    print(f"TOOL_CONNECTIONS_DERIVED='{encoded}'")
    print('export TOOL_SERVER_CONNECTIONS="${TOOL_SERVER_CONNECTIONS:-$TOOL_CONNECTIONS_DERIVED}"')
    print(f'echo "openwebui-entrypoint: {len(tool_connections)} MCP server(s) configured" >&2')

if jupyter_url:
    print('export CODE_EXECUTION_ENGINE="${CODE_EXECUTION_ENGINE:-jupyter}"')
    print(f'CODE_EXECUTION_JUPYTER_URL_DERIVED="{jupyter_url}"')
    print('export CODE_EXECUTION_JUPYTER_URL="${CODE_EXECUTION_JUPYTER_URL:-$CODE_EXECUTION_JUPYTER_URL_DERIVED}"')
    print('export CODE_EXECUTION_JUPYTER_AUTH="${CODE_EXECUTION_JUPYTER_AUTH:-token}"')
    print('export CODE_EXECUTION_JUPYTER_TIMEOUT="${CODE_EXECUTION_JUPYTER_TIMEOUT:-60}"')
    print('export CODE_INTERPRETER_ENGINE="${CODE_INTERPRETER_ENGINE:-jupyter}"')
    print(f'CODE_INTERPRETER_JUPYTER_URL_DERIVED="{jupyter_url}"')
    print('export CODE_INTERPRETER_JUPYTER_URL="${CODE_INTERPRETER_JUPYTER_URL:-$CODE_INTERPRETER_JUPYTER_URL_DERIVED}"')
    print('export CODE_INTERPRETER_JUPYTER_AUTH="${CODE_INTERPRETER_JUPYTER_AUTH:-token}"')
    print('export CODE_INTERPRETER_JUPYTER_TIMEOUT="${CODE_INTERPRETER_JUPYTER_TIMEOUT:-60}"')
    if jupyter_token:
        print(f'CODE_EXECUTION_JUPYTER_AUTH_TOKEN_DERIVED="{jupyter_token}"')
        print('export CODE_EXECUTION_JUPYTER_AUTH_TOKEN="${CODE_EXECUTION_JUPYTER_AUTH_TOKEN:-$CODE_EXECUTION_JUPYTER_AUTH_TOKEN_DERIVED}"')
        print(f'CODE_INTERPRETER_JUPYTER_AUTH_TOKEN_DERIVED="{jupyter_token}"')
        print('export CODE_INTERPRETER_JUPYTER_AUTH_TOKEN="${CODE_INTERPRETER_JUPYTER_AUTH_TOKEN:-$CODE_INTERPRETER_JUPYTER_AUTH_TOKEN_DERIVED}"')
    print(f'echo "openwebui-entrypoint: Jupyter code execution at {jupyter_url}" >&2')
PYEOF
)"
fi

# --- Admin credentials (MANDATORY) ---
MISSING=""
if [ -z "${WEBUI_ADMIN_EMAIL:-}" ]; then
    MISSING="WEBUI_ADMIN_EMAIL"
fi
if [ -z "${WEBUI_ADMIN_PASSWORD:-}" ]; then
    [ -n "$MISSING" ] && MISSING="$MISSING, "
    MISSING="${MISSING}WEBUI_ADMIN_PASSWORD"
fi
if [ -n "$MISSING" ]; then
    echo "" >&2
    echo "ERROR: Missing required environment variable(s): $MISSING" >&2
    echo "" >&2
    echo "Open WebUI needs admin credentials to create the first user account." >&2
    echo "" >&2
    echo "WEBUI_ADMIN_EMAIL is plaintext config (declared in env_require)." >&2
    echo "WEBUI_ADMIN_PASSWORD is a credential-backed secret (declared in secret_require);" >&2
    echo "store it once in the credential backend and it flows in via a podman secret:" >&2
    echo "" >&2
    echo "  charly secrets set charly/secret WEBUI_ADMIN_PASSWORD your-password" >&2
    echo "  charly config openwebui -e WEBUI_ADMIN_EMAIL=you@example.com --update-all" >&2
    echo "" >&2
    echo "Or pass both via -e on first run — the password is auto-imported into" >&2
    echo "the credential backend and stripped from deploy.yml / the quadlet:" >&2
    echo "" >&2
    echo "  charly config openwebui -e WEBUI_ADMIN_EMAIL=you@example.com -e WEBUI_ADMIN_PASSWORD=your-password" >&2
    echo "" >&2
    exit 1
fi
export WEBUI_ADMIN_NAME="${WEBUI_ADMIN_NAME:-Admin}"

echo "openwebui-entrypoint: admin account: $WEBUI_ADMIN_EMAIL"
echo "openwebui-entrypoint: starting Open WebUI on port ${PORT:-8080}"
# `open-webui serve` takes the port as a Typer option and never reads $PORT
# (open_webui/__init__.py), so the declared env has to be passed through here.
exec open-webui serve --port "${PORT:-8080}"
